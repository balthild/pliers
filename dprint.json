{
	"includes": [
		".vscode/*.json",
		".swift-format",
		"dprint.json",
		"Resources/**/*.{js,css}",
		"Public/js/*.js",
		"Sources/PliersDBus/*.xml",
		"Sources/**/*.swift",
		"Package.swift",
		"nfpm.yaml",
	],
	"excludes": [
		".build",
	],
	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,
	"oxc": {
		"quoteStyle": "single",
		"quoteProperties": "consistent",
		"experimentalSortImports": {
			"groups": [
				["style", "side_effect_style"],
				["builtin"],
				["external"],
				["internal", "subpath"],
				["parent", "sibling", "index"],
				["unknown"],
			],
		},
	},
	"markup": {
		"associations": ["*.{html,svg,xml}"],
		"styleIndent": true,
		"scriptIndent": true,
		"scriptFormatter": "biome",
		"html.void.selfClosing": true,
		"component.selfClosing": true,
	},
	"malva": {
		"quotes": "preferSingle",
	},
	"json": {
		"associations": ["*.{json,jsonc}", ".swift-format"],
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": [
			"dprint.json",
			".vscode/extensions.json",
			".vscode/launch.json",
			".vscode/settings.json",
		],
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "swift-format {{file_path}}",
				"exts": ["swift"],
				"cacheKeyFiles": [".swift-format"],
				"stdin": false,
			},
		],
	},
	"plugins": [
		"npm:@dprint/oxc@0.38.0",
		"npm:@dprint/json@0.23.0",
		"npm:dprint-plugin-markup@0.27.3",
		"npm:dprint-plugin-malva@0.16.0",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
	],
}
