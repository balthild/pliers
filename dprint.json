{
	"excludes": [
		".build",
		".index-build",
		"node_modules",
		"Public/dist",
		"package-lock.json",
	],
	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,
	"oxc": {
		"associations": ["!**/*.{css,json,jsonc,yml,yaml}"],
		"quoteStyle": "single",
		"quoteProperties": "consistent",
		"experimentalSortImports": {
			"groups": [
				["style", "side_effect_style"],
				["builtin"],
				["external"],
				["internal", "subpath"],
				["parent", "sibling", "index"],
				["unknown"],
			],
		},
	},
	"markup": {
		"associations": ["*.{html,svg,xml}"],
		"styleIndent": true,
		"scriptIndent": true,
		"scriptFormatter": "biome",
		"html.void.selfClosing": true,
		"component.selfClosing": true,
	},
	"malva": {
		"quotes": "preferSingle",
		"blockSelectorLinebreak": "consistent",
		"selectors.preferSingleLine": true,
	},
	"json": {
		"associations": [".swift-format"],
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": [
			"dprint.json",
			"tsconfig.json",
			".vscode/*.json",
		],
	},
	"ruff": {
		"preview": true,
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "swift-format {{file_path}}",
				"exts": ["swift"],
				"cacheKeyFiles": [".swift-format"],
				"stdin": false,
			},
		],
	},
	"plugins": [
		"npm:@dprint/oxc@0.49.1",
		"npm:@dprint/json@0.26.0",
		"npm:@dprint/ruff@0.12.1",
		"npm:dprint-plugin-markup@0.27.6",
		"npm:dprint-plugin-malva@0.16.0",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
	],
}
